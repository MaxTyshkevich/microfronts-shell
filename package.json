{
  "name": "@microfronts/shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix ../catalog run dev:remote\" \"npm --prefix ../cart run dev:remote\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "build:local": "vite build --mode integration"
  },
  "dependencies": {
    "@microfronts/platform": "file:vendor/microfronts-platform-0.1.0.tgz",
    "@microfronts/ui": "file:vendor/microfronts-ui-0.1.0.tgz",
    "@module-federation/runtime": "2.9.0",
    "@module-federation/vite": "1.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
