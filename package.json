{
  "name": "@microfronts/shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix ../catalog run dev:remote\" \"npm --prefix ../cart run dev:remote\" \"npm --prefix ../backend run start:dev\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "check:architecture": "node scripts/check-architecture.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:local": "vite build --mode integration"
  },
  "dependencies": {
    "@microfronts/contracts": "file:vendor/microfronts-contracts-0.1.0.tgz",
    "@microfronts/ui": "file:vendor/microfronts-ui-0.2.0-tailwind.0.tgz",
    "@module-federation/runtime": "2.9.0",
    "@module-federation/vite": "1.21.0",
    "@tanstack/react-query": "5.103.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
