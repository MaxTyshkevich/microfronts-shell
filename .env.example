# Copy this file to .env.local for local development. Defaults run everything locally.
API_PROXY_TARGET=http://localhost:3000
# A hosted API can be used through the local Vite proxy:
# API_PROXY_TARGET=https://YOUR-API.onrender.com
# Proxy /api on the Shell origin to backend, preserving Cookie and Set-Cookie.
VITE_API_BASE_URL=/api
# CORS_ORIGINS on backend must include the public Shell origin.
# Override only the remote you want to get from the shared hosted environment:
# VITE_CATALOG_REMOTE_URL=https://YOUR-CATALOG.onrender.com/remoteEntry.js
# VITE_CART_REMOTE_URL=https://YOUR-CART.onrender.com/remoteEntry.js
